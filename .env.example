# =============================================================================
# Voice Ordering System — 100% Free Tier (lowest latency defaults)
# =============================================================================
# Voice needs 3 free API keys: Groq + Deepgram + LiveKit Cloud.
# Text chat works with zero API keys (SQLite built-in).

# --- Database (optional — defaults to local SQLite) ---
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voice_ordering

# --- LLM: Groq FREE (console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Voice uses fastest free model with tool calling (~1000 tok/s)
GROQ_VOICE_MODEL=openai/gpt-oss-20b

# --- STT + TTS: Deepgram FREE $200 credit (console.deepgram.com) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en
# DEEPGRAM_ENDPOINTING_MS=200

# --- TTS: Deepgram Aura streaming (default, fast) ---
USE_EDGE_TTS=false
# Slow 100%-free fallback if Deepgram credits run out (needs ffmpeg):
# USE_EDGE_TTS=true
# EDGE_TTS_VOICE=en-US-AriaNeural

# --- ffmpeg (only for Edge TTS fallback) ---
# FFMPEG_PATH=C:\Users\YOURNAME\AppData\Local\Microsoft\WinGet\Packages\...\bin\ffmpeg.exe

# --- Voice latency tuning ---
# VOICE_PREEMPTIVE=true
# VOICE_PREEMPTIVE_TTS=true
# VOICE_ENDPOINT_MIN_DELAY=0.2
# VOICE_ENDPOINT_MAX_DELAY=1.2

# --- LiveKit Cloud FREE tier (cloud.livekit.io) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the worker agent_name (explicit dispatch — agent joins on Connect Microphone)
LIVEKIT_AGENT_NAME=dialog-order-agent

# --- Paid providers (disabled unless VOICE_ALLOW_PAID=true) ---
# VOICE_ALLOW_PAID=false
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=

# --- Optional email notifications ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_EMAIL=

# --- Product platform (v2) ---
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=  # REQUIRED: Generate with: openssl rand -hex 16 or pwgen 20 1
# AUTH_SECRET=  # REQUIRED: Generate with: openssl rand -hex 32
# POS_PROVIDER=mock
# PETPOOJA_API_KEY=
# PETPOOJA_OUTLET_ID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# UPI_VPA=dialogpizza@upi
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# DEFAULT_NOTIFY_PHONE=+919876543210
